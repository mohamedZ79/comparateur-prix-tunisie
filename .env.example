# Copiez ce fichier en .env (ou configurez les secrets CI) et adaptez.

# --- requis -------------------------------------------------------------
# URL PostgreSQL (Supabase : Settings > Database > Connection string,
# utiliser la chaine du pooler IPv4)
DATABASE_URL=postgresql://user:password@host:5432/postgres

# --- recherche / sécurité ------------------------------------------------
# Origines autorisées pour CORS (séparées par des virgules).
# Mettez l'URL de votre frontend Netlify.
ALLOWED_ORIGINS=https://prixtn.netlify.app,http://localhost:8000

# Limitation de débit (par IP)
RATE_LIMIT=30
RATE_WINDOW=60

# --- sites Cloudflare (Sangour, Wamia, T-Discount, Scoop, Graiet,
#     Maalej, Affariyet, Bricorama, Electro Tounes) ------------------------
# Ces boutiques défient TOUTES les requêtes venant d'une IP datacenter
# (vérifié en aout 2026, y compris /wp-json et les sitemaps). Depuis une
# IP résidentielle tunisienne, le challenge se résout tout seul.
# Définissez ici un proxy résidentiel tunisien pour les débloquer :
#   http://user:password@proxy-host:port
PROXY_URL=

# --- crawler --------------------------------------------------------------
# Nombre maximal de pages Drest ingérées par nuit (300 pages x 100 = catalogue
# complet d'environ 27 000 produits)
DREST_MAX_PAGES=300
